new file mode 100644
index 0000000..e8b834b
--- /dev/null
+++ b/include/localization_frames.h
@@ -0,0 +1,33 @@
+#pragma once
+#include <Eigen/Geometry>
+#include <cmath>
+#include <stdexcept>
+
+namespace localization_frames {
+inline Eigen::Matrix3d bodyRotation(double roll, double pitch, double yaw) {
+    if (!std::isfinite(roll) || !std::isfinite(pitch) || !std::isfinite(yaw))
+        throw std::runtime_error("Invalid initial body angles");
+    return (Eigen::AngleAxisd(yaw,Eigen::Vector3d::UnitZ()) *
+            Eigen::AngleAxisd(pitch,Eigen::Vector3d::UnitY()) *
+            Eigen::AngleAxisd(roll,Eigen::Vector3d::UnitX())).toRotationMatrix();
+}
+// A,b map internal-world coordinates into the shared/public map.
+// They also map the sensor IMU frame into the body frame.
+inline Eigen::Isometry3d initialMappingPose(
+    const Eigen::Matrix3d& A, const Eigen::Vector3d& b,
+    const Eigen::Matrix3d& body_rotation, const Eigen::Vector3d& body_position) {
+    Eigen::Isometry3d pose = Eigen::Isometry3d::Identity();
+    pose.linear() = A.transpose() * body_rotation * A;
+    pose.translation() = A.transpose() * (body_position - b + body_rotation * b);
+    return pose;
+}
+
+inline Eigen::Vector3d gravityInMappingFrame(
+    const Eigen::Matrix3d& imu_rotation, const Eigen::Vector3d& mean_acc,
+    double gravity) {
+    if (!mean_acc.allFinite() || mean_acc.norm() < 1e-6 ||
+        !imu_rotation.allFinite() || !std::isfinite(gravity) || gravity <= 0)
+        throw std::runtime_error("Invalid IMU gravity initialization");
+    return -imu_rotation * mean_acc.normalized() * gravity;
+}
+}
