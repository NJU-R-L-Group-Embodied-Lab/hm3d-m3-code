+void pointMappingWorldToOutput(PointType const * const pi, PointType * const po)
+{
+    const V3D p_mapping(pi->x, pi->y, pi->z);
+    const V3D p_output(Output_R_wrt_Mapping*p_mapping + Output_T_wrt_Mapping);
+    *po = *pi;
