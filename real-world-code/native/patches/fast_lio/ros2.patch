--- /dev/null
+++ b/tests/localization_frames_test.cpp
@@ -0,0 +1,36 @@
+#include "localization_frames.h"
+#include <iostream>
+using namespace Eigen;
+void check(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+int main() {
+    const double pi=std::acos(-1.0);
+    const Matrix3d A=AngleAxisd(13*pi/180,Vector3d::UnitY()).toRotationMatrix();
+    const Vector3d lidar_in_body(.187,0,.0803),lidar_in_imu(-.011,-.02329,.04412);
+    const Vector3d b=lidar_in_body-A*lidar_in_imu,p(2.5,2,0),point(1.2,-.4,2.3);
+    for(double tilt:{0.,0.17}) for(double yaw:{0.,pi/2,-pi/2,pi}) {
+        const Matrix3d Q=localization_frames::bodyRotation(tilt,-tilt/2,yaw);
+        if(tilt==0)check((Q-AngleAxisd(yaw,Vector3d::UnitZ()).toRotationMatrix()).norm()<1e-12,"yaw compatibility");
+        check((localization_frames::bodyRotation(pi/2,0,0)*Vector3d::UnitY()-Vector3d::UnitZ()).norm()<1e-12,"roll convention");
+        check((localization_frames::bodyRotation(0,pi/2,0)*Vector3d::UnitZ()-Vector3d::UnitX()).norm()<1e-12,"pitch convention");
+        const auto pose=localization_frames::initialMappingPose(A,b,Q,p);
+        check((A*pose.linear()*A.transpose()-Q).norm()<1e-12,"rotation roundtrip");
+        check((A*pose.translation()+b-Q*b-p).norm()<1e-12,"position roundtrip");
+        // Independently transform one raw LiDAR point using body extrinsics,
+        // then compare with the exact path used by internal scan matching.
+        const Vector3d shared=p+Q*(A*point+lidar_in_body);
+        const Vector3d prior_internal=A.transpose()*(shared-b);
+        const Vector3d scan_internal=pose*(point+lidar_in_imu);
+        check((prior_internal-scan_internal).norm()<1e-12,"prior/scan coordinates differ");
+        const Vector3d measured=A.transpose()*Q.transpose()*Vector3d::UnitZ();
+        const Vector3d g=localization_frames::gravityInMappingFrame(pose.linear(),measured,9.81);
+        check((pose.linear()*measured*9.81+g).norm()<1e-12,"stationary IMU accelerates");
+        check((A*g+9.81*Vector3d::UnitZ()).norm()<1e-12,"shared gravity tilted");
+    }
+    const Vector3d measured(.1,.2,.97);
+    check((localization_frames::gravityInMappingFrame(Matrix3d::Identity(),measured,9.81)+measured.normalized()*9.81).norm()<1e-12,"mapping initialization changed");
+    bool rejected=false;try {localization_frames::gravityInMappingFrame(A,Vector3d::Zero(),9.81);}catch(const std::runtime_error&){rejected=true;}
+    check(rejected,"zero acceleration accepted");
+    std::cout<<"PASS: pose inverse, raw scan/prior alignment, gravity, mapping compatibility, invalid IMU\n";
+}
