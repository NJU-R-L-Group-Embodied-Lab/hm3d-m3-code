+
+void transformMappingCloudToOutput(PointCloudXYZI &cloud)
+{
+    for (auto &point : cloud.points)
+    {
+        PointType transformed;
+        pointMappingWorldToOutput(&point, &transformed);
+        point = transformed;
+    }
+}
+
+void transformOutputCloudToMapping(PointCloudXYZI &cloud)
+{
+    const M3D R_inv = Output_R_wrt_Mapping.transpose();
+    for (auto &point : cloud.points)
+    {
+        const V3D p_output(point.x, point.y, point.z);
+        const V3D p_mapping = R_inv * (p_output - Output_T_wrt_Mapping);
+        point.x = p_mapping(0);
+        point.y = p_mapping(1);
+        point.z = p_mapping(2);
+    }
+}
+
+void getOutputBasePose(M3D &rotation, V3D &translation)
+{
+    // Conjugate the internal Mid-360 IMU pose into a map frame whose origin
+    // and axes coincide with the GO2 base IMU at mapping start.
+    rotation = Output_R_wrt_Mapping * state_point.rot *
+               Output_R_wrt_Mapping.transpose();
+    translation = Output_R_wrt_Mapping * state_point.pos +
+                  Output_T_wrt_Mapping - rotation * Output_T_wrt_Mapping;
+}
