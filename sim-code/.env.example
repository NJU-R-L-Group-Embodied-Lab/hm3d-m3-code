# HM3D-M3 environment. Copy to sim-code/.env (docker compose reads it with
# `--env-file .env`) or export the variables in your shell.
# Never commit a real key.

# --- hosted VLM (OpenAI-compatible endpoint) -------------------------------------
# Used by LaViRA-M3, Co-NavGPT2 and TN generation. The paper used Qwen3.5-27B on
# Aliyun Bailian / DashScope compatible mode.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-27b
# Accepted as fallbacks when the LLM_* names are unset (the model is read from LLM_MODEL only):
#   DASHSCOPE_API_KEY, LAVIRA_API_KEY, DASHSCOPE_BASE_URL

# --- host paths mounted by docker/compose.yaml -----------------------------------
# DATA_ROOT is mounted at sim-code/data inside the containers (scene_datasets/,
# datasets/, grounded_sam/ ...). MODEL_ROOT is mounted at sim-code/data/models.
# Relative paths resolve against sim-code/docker/.
DATA_ROOT=../data
MODEL_ROOT=../data/models

# --- container user (docker compose) -----------------------------------------------
# The m3 service runs as HOST_UID:HOST_GID, so files it writes under sim-code/ stay owned
# by you. Set them to the output of `id -u` and `id -g`; empty = root. The owl
# service always runs as root (it writes logs/owl/).
HOST_UID=
HOST_GID=

# --- Python interpreter used by the scripts in scripts/ --------------------------
PY=python

# --- OWL detector sidecar (adapted baselines only) -------------------------------
# One sidecar per GPU in OWL_GPUS; the sidecar on GPU g listens on OWL_PORT_BASE+g.
# The run scripts derive OWL_URL=http://$OWL_HOST:$((OWL_PORT_BASE+g)) unless
# OWL_URL is set explicitly (single sidecar for all workers).
OWL_GPUS=0
OWL_HOST=127.0.0.1
OWL_PORT_BASE=18210
OWL_URL=
# Shared frame directory. Outside Docker the default is $PWD/.owl_shm; compose
# sets /workspace/sim/.owl_shm for both containers.
OWL_SHM_DIR=
# Set to 1 once the OWLv2 / CLIP weights are in the Hugging Face cache.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# --- model weights -----------------------------------------------------------------
VLFM_BLIP2_DIR=data/models/blip2-itm-vit-g
# DM3-Nav (user-provided; SuperGlue is non-commercial)
DM3_SUPERGLUE_WEIGHTS_DIR=data/datasets/dm3_official/superglue_weights
DM3_DETIC_CHECKPOINT=data/datasets/dm3_official/detic.pth

# --- image build options (docker compose build) ----------------------------------
# 0 = skip requirements-baselines.txt + detectron2 (enough for LaViRA-M3 rows)
WITH_BASELINES=1
# (GroundingDINO is always installed: every LaViRA-M3 row imports it.)
MAX_JOBS=8
